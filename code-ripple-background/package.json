{
  "name": "dsh-coderipple",
  "version": "3.3.2",
  "private": false,
  "type": "module",
  "description": "Seven switchable code-art background presets (ambient code field, DeepSeek whale, maid portraits, rotating 3D globe, and a static earth-continent map without Antarctica) for the DeepSeek Harness Web UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "title": "Code Ripple — code-art backgrounds for DeepSeek Harness",
  "author": "zhangyuzhangyu233",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyuzhangyu233/dsh-coderipple.git"
  },
  "homepage": "https://github.com/zhangyuzhangyu233/dsh-coderipple#readme",
  "bugs": {
    "url": "https://github.com/zhangyuzhangyu233/dsh-coderipple/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wallpaper",
    "live-wallpaper",
    "webgl",
    "code-art"
  ],
  "publishConfig": {
    "access": "public"
  }
}
